5. Deploying to Kubernetes

Deployment Manifest

apiVersion: apps/v1
kind: Deployment

metadata:
  name: myapp

spec:
  replicas: 3

  selector:
    matchLabels:
      app: myapp

  template:
    metadata:
      labels:
        app: myapp

    spec:
      containers:
      - name: myapp

        image: myrepo/myapp:v1

        ports:
        - containerPort: 8000


---

Service Manifest

apiVersion: v1
kind: Service

metadata:
  name: myapp

spec:
  type: LoadBalancer

  selector:
    app: myapp

  ports:
  - port: 80
    targetPort: 8000

Apply:

kubectl apply -f deployment.yaml
kubectl apply -f service.yaml


